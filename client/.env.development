# In local development, call the backend directly to bypass the CRA proxy.
# The CRA proxy (webpack-dev-server) has a body size limit that blocks large
# file uploads (e.g. 25MB+ sales call recordings). Direct calls work because
# CORS is configured to allow localhost:3000 → localhost:5000.
# 
# In production this file is NOT loaded — the app uses '/api/v1' (relative URL).
REACT_APP_API_URL=http://localhost:5000/api/v1
