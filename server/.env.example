# ============================================
# LMS SaaS - Environment Configuration Template
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in all values (replace placeholders)
# 3. NEVER commit .env to git
# 4. Keep this .env.example in sync with new variables
#
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# MongoDB Configuration
# Format: mongodb://username:password@host:port/database?authSource=admin
MONGODB_URI=mongodb://admin:YOUR_STRONG_PASSWORD@mongodb:27017/lms-saas?authSource=admin

# JWT Configuration (generate a random 64-char string)
# Command: openssl rand -hex 32
JWT_SECRET=GENERATE_A_RANDOM_64_CHARACTER_STRING_HERE
JWT_EXPIRES_IN=7d

# Frontend URL (your domain)
CLIENT_URL=https://platform.codebegun.com
FRONTEND_URL=https://platform.codebegun.com

# ===== Email Service Configuration =====
# Gmail Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_FROM=LMS Support <your-email@gmail.com>

# ===== AI Service Configuration =====
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===== Redis Configuration (for scaling) =====
REDIS_URL=redis://redis:6379

# ===== Rate Limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
