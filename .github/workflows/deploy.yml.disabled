name: Auto Deploy to VPS on Push to Master

on:
  push:
    branches:
      - master
  workflow_dispatch: # Allow manual trigger

env:
  VPS_HOST: 187.124.97.56
  VPS_USER: root
  VPS_APP_PATH: /root/lms

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Set up Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'

      - name: Install dependencies (root)
        run: npm install

      - name: Install dependencies (server)
        run: |
          cd server
          npm install
          cd ..

      - name: Install dependencies (client)
        run: |
          cd client
          npm install
          cd ..

      - name: Build server
        run: |
          cd server
          npm run build
          cd ..

      - name: Build client
        run: |
          cd client
          npm run build
          cd ..

      - name: Verify builds
        run: |
          echo "✓ Server build:"
          ls -la server/dist | head -5
          echo "✓ Client build:"
          ls -la client/build | head -5

      - name: Deploy to VPS
        env:
          VPS_PASSWORD: ${{ secrets.VPS_PASSWORD }}
        run: |
          # Install sshpass
          sudo apt-get update
          sudo apt-get install -y sshpass
          
          # Create deployment script
          cat > /tmp/deploy-vps.sh << 'DEPLOY_EOF'
          #!/bin/bash
          set -e
          
          echo "========================================="
          echo "LMS Auto Deployment Started"
          echo "========================================="
          echo ""
          
          # Navigate to app directory
          cd $VPS_APP_PATH
          
          # Pull latest code
          echo "Step 1: Pulling latest code from master..."
          git pull origin master
          echo "✓ Code pulled successfully"
          echo ""
          
          # Install and build server
          echo "Step 2: Building server..."
          cd server
          npm install
          npm run build
          cd ..
          echo "✓ Server built successfully"
          echo ""
          
          # Install and build client
          echo "Step 3: Building client..."
          cd client
          npm install
          npm run build
          cd ..
          echo "✓ Client built successfully"
          echo ""
          
          # Copy client build
          echo "Step 4: Deploying client..."
          sudo cp -r client/build/* /var/www/html/ 2>/dev/null || true
          echo "✓ Client deployed"
          echo ""
          
          # Restart server
          echo "Step 5: Restarting application..."
          cd server
          pm2 restart lms-server 2>/dev/null || pm2 start dist/server.js --name lms-server
          echo "✓ Application restarted"
          echo ""
          
          # Verify deployment
          echo "========================================="
          echo "Deployment Status:"
          echo "========================================="
          pm2 list
          echo ""
          echo "✓ Application Live at: http://187.124.97.56:3000"
          DEPLOY_EOF
          
          chmod +x /tmp/deploy-vps.sh
          
          # Execute deployment using SSHPASS env var (handles special characters better)
          echo "Connecting to VPS and deploying..."
          export SSHPASS="$VPS_PASSWORD"
          sshpass -e ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o PubkeyAuthentication=no $VPS_USER@$VPS_HOST "bash -s" < /tmp/deploy-vps.sh

      - name: Deployment Success
        if: success()
        run: |
          echo ""
          echo "╔════════════════════════════════════════╗"
          echo "║  ✓ Deployment Successful!             ║"
          echo "║  Application: http://187.124.97.56:3000║"
          echo "║  Branch: master                        ║"
          echo "║  Commit: ${{ github.sha }}             ║"
          echo "╚════════════════════════════════════════╝"

      - name: Deployment Failed
        if: failure()
        run: |
          echo ""
          echo "╔════════════════════════════════════════╗"
          echo "║  ✗ Deployment Failed!                 ║"
          echo "║  Check GitHub Actions logs for details║"
          echo "╚════════════════════════════════════════╝"
