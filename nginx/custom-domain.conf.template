# ============================================================================
# An institute's own domain (__DOMAIN__). Generated by scripts/add-custom-domain.sh
# from this template — edit the TEMPLATE, not the generated file.
#
# Same app, same active blue/green slot as platform.codebegun.com (upstream
# lms_backend is defined there). The app reads the Host header to know which
# institute the domain belongs to. certbot adds the 443 block and redirect.
# Keep the locations in step with platform.codebegun.com.conf.
# ============================================================================

server {
    listen 80;
    server_name __DOMAIN__;

    rewrite "^(.*/battles/exam/)\{\{1\}\}(.+)$" $1$2 last;

    location ~ "^/api/v1/public/hackathon-exams/attempt/[^/]+/recording/chunk$" {
        return 503;
    }

    location /static/ {
        alias /var/www/lms-static/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri @app;
    }

    location @app {
        proxy_pass http://lms_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://lms_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        client_max_body_size 1200M;
        proxy_connect_timeout 10s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;
    }
}
