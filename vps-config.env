# 🔧 VPS Deployment Configuration
# Customize these values for your specific setup

# VPS Connection Details
export VPS_IP="YOUR_VPS_IP_ADDRESS"           # Example: 123.456.789.123
export VPS_USER="root"                        # Or "ubuntu" depending on your VPS
export VPS_PORT="22"                         # SSH port, usually 22

# Domain Configuration  
export DOMAIN_NAME="your-domain.com"         # Your domain name without www
export EMAIL="admin@your-domain.com"         # Email for SSL certificate and admin

# Database Configuration
export DB_NAME="lms_saas_production"         # MongoDB database name
export DB_USER="lms_admin"                  # Database username
export DB_PASS="$(openssl rand -base64 16)" # Generated secure password

# Security Configuration
export JWT_SECRET="$(openssl rand -base64 32)"     # JWT signing secret
export SESSION_SECRET="$(openssl rand -base64 32)" # Session secret

# Application Configuration
export NODE_ENV="production"
export SERVER_PORT="5000"
export CLIENT_PORT="3000"

# GitHub Repository (if different)
export REPO_URL="https://github.com/mynameiscod/lms.git"

# Backup Configuration
export BACKUP_RETENTION_DAYS="7"            # How many days to keep backups

# Email Service Configuration (Optional)
export SMTP_HOST="smtp.gmail.com"           # Email provider SMTP
export SMTP_PORT="587"                      # SMTP port
export SMTP_USER="your-email@gmail.com"     # SMTP username
export SMTP_PASS="your-app-password"        # SMTP password/app password

# Memory and Performance
export PM2_INSTANCES="max"                  # PM2 instances (max = CPU cores)
export MAX_MEMORY="1G"                      # Maximum memory per instance

# SSL Configuration
export SSL_PROVIDER="letsencrypt"           # SSL certificate provider
export FORCE_HTTPS="true"                  # Redirect HTTP to HTTPS

print_config() {
    echo "🔧 Current VPS Deployment Configuration:"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "VPS Details:"
    echo "  • IP Address: ${VPS_IP}"
    echo "  • SSH User: ${VPS_USER}"
    echo "  • SSH Port: ${VPS_PORT}"
    echo ""
    echo "Domain & SSL:"
    echo "  • Domain: ${DOMAIN_NAME}"
    echo "  • Admin Email: ${EMAIL}"
    echo "  • SSL Provider: ${SSL_PROVIDER}"
    echo ""
    echo "Database:"
    echo "  • Database Name: ${DB_NAME}"
    echo "  • Database User: ${DB_USER}"
    echo ""
    echo "Application:"
    echo "  • Environment: ${NODE_ENV}"
    echo "  • Server Port: ${SERVER_PORT}"
    echo "  • Repository: ${REPO_URL}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

# Validation function
validate_config() {
    local errors=0
    
    [[ -z "$VPS_IP" || "$VPS_IP" == "YOUR_VPS_IP_ADDRESS" ]] && {
        echo "❌ VPS_IP is required"
        errors=$((errors + 1))
    }
    
    [[ -z "$DOMAIN_NAME" || "$DOMAIN_NAME" == "your-domain.com" ]] && {
        echo "❌ DOMAIN_NAME is required"
        errors=$((errors + 1))
    }
    
    [[ -z "$EMAIL" || "$EMAIL" == "admin@your-domain.com" ]] && {
        echo "❌ EMAIL is required"
        errors=$((errors + 1))
    }
    
    if [[ $errors -eq 0 ]]; then
        echo "✅ Configuration validation passed"
        return 0
    else
        echo "❌ Please fix the configuration errors above"
        return 1
    fi
}

# Quick setup function for common configurations
quick_setup() {
    case "$1" in
        "basic")
            echo "🚀 Basic setup selected"
            export SSL_PROVIDER="letsencrypt"
            export PM2_INSTANCES="2"
            export MAX_MEMORY="512M"
            ;;
        "high-performance")
            echo "⚡ High-performance setup selected"
            export PM2_INSTANCES="max"
            export MAX_MEMORY="2G"
            export BACKUP_RETENTION_DAYS="14"
            ;;
        "development")
            echo "🔧 Development setup selected"
            export NODE_ENV="development"
            export SSL_PROVIDER="self-signed"
            export PM2_INSTANCES="1"
            ;;
        *)
            echo "Available quick setups: basic, high-performance, development"
            ;;
    esac
}

# Run configuration check if sourced
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    echo "📋 VPS Configuration loaded"
    echo "Run 'print_config' to see current settings"
    echo "Run 'validate_config' to check configuration"
    echo "Run 'quick_setup basic|high-performance|development' for presets"
fi