# Docker ignore file to optimize build process

# Node modules
**/node_modules
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Build directories
client/build
server/dist

# Environment files — exclude at ALL levels (not just root). client/.env points
# at http://localhost:5000 for local dev; if it leaks into the Docker build, CRA
# bakes localhost into the PRODUCTION bundle (a plain `.env` pattern only matches
# the root, so client/.env was slipping through and breaking prod API calls).
**/.env
**/.env.*

# Git and version control
.git
.gitignore
**/.git
**/.gitignore

# IDE files
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Coverage reports
coverage

# Testing
.nyc_output

# Misc
.cache
.temp
*.tmp

# Deployment files
DEPLOY.bat
DOCKER_COMMANDS.md
DOCKER_DEPLOY.bat
docker-deploy.sh
DEPLOYMENT_GUIDE.md
MANUAL_DEPLOYMENT.md
GITHUB_ACTIONS_*.md

# Documentation  
README.md
docs/**

# Test files
**/*.test.*
**/*.spec.*
**/test/**
**/tests/**

# Question templates
question-templates/**