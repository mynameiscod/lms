# Compose-level environment — lives at /root/lms/.env on the VPS.
#
# This is NOT server/.env. docker-compose reads variable substitutions
# (${...}) only from the .env file next to docker-compose.yml, so the
# database and cache credentials must live here. server/.env is passed
# into the app containers via `env_file:` and holds the app's own secrets
# (Brevo, Razorpay, Anthropic, 100ms, ...).
#
# Setup:
#   cp .env.example .env && chmod 600 .env
#   then fill each value with freshly generated secrets — never reuse the
#   pre-2026-08-07 ones, the host was root-compromised while they were on disk.
#
# Generate a strong value with:
#   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# ── MongoDB ──────────────────────────────────────────────────────────────
# Was admin/password123 on a public port until 2026-08-07. Rotating this is
# a two-step operation on an existing volume: change the password INSIDE
# Mongo first (db.changeUserPassword), then set it here. Setting it here
# alone does nothing — MONGO_INITDB_* is only read when the volume is empty.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────
# Unauthenticated Redis was the cryptominer's way in. This password is
# consumed by redis-server --requirepass and handed to the app as
# REDIS_PASSWORD, which BullMQ already reads.
REDIS_PASSWORD=

# ── App ──────────────────────────────────────────────────────────────────
# Rotating this invalidates every issued token, so all users are logged out
# once. That is the intended effect: the old secret was readable by the
# attacker, and a forgeable admin JWT is a standing back door.
JWT_SECRET=

# Encrypts the API keys held in Platform Settings (SystemSetting rows where
# isSecret=true: Anthropic, OpenAI, Razorpay, Brevo, 100ms, Meta).
#
# MUST be set and MUST be different from JWT_SECRET. settingsService falls back
# to JWT_SECRET and then to a hardcoded literal, so leaving this blank couples
# the two: rotating JWT_SECRET would then make every stored API key
# undecryptable, and the app would report them as unset.
#
# Changing this value orphans everything already encrypted with the old one.
# On a fresh server that is fine and expected — you are re-entering freshly
# rotated keys in Platform Settings anyway.
ENCRYPTION_KEY=
