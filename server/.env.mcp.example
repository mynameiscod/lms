# Keep disabled until staging verification and deployment approval.
MCP_ENABLED=false
MCP_ISSUER_URL=https://lms.example.com
MCP_RESOURCE_URL=https://lms.example.com/mcp
# Pre-register the exact callback displayed by your MCP client. No wildcards.
# Grant only scopes needed by this client. Existing LMS permissions still apply.
MCP_OAUTH_CLIENTS=[{"id":"codebegun-assistant","name":"CodeBegun Assistant","applicationType":"web","redirectUris":["https://client.example.com/exact-callback"],"tokenEndpointAuthMethod":"none","scopes":["mcp_connect","mcp_students_read","mcp_batches_read","mcp_attendance_read","mcp_assessments_read","mcp_finance_read","mcp_placements_read","mcp_leads_read","mcp_calls_read","offline_access"]}]
# Optional exact HTTPS browser origins, comma-separated. Server-to-server clients need none.
MCP_ALLOWED_ORIGINS=
# Use the existing LMS MongoDB credentials, with replica-set transactions supported.
# MONGODB_URI=...  (set through the existing secret manager; never commit it)
# TRUST_PROXY_HOPS=1 (existing app setting; proxy must overwrite forwarded headers)
# Confidential clients: tokenEndpointAuthMethod=client_secret_basic and secretHash=<SHA-256 hex
# of a randomly generated >=32-byte client secret>. Distribute the raw secret once out of band.
# Do not use MCP_INTERNAL_ENABLED, MCP_AUTH_MODE, or MCP_OAUTH_CLIENT_IDS: they are obsolete.
